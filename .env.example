# Environment variables read by Logiks Core.
#
# Logiks does not load a .env file itself: set these in the real process environment
# (php-fpm `env[...]`, Apache `SetEnv`, systemd `Environment=`, docker `-e`, etc.).
# When set, they override the matching values in config/security.cfg, so secrets never
# have to be stored in (or committed with) the config files.
#
# Generate each value with:  openssl rand -hex 32

# Salt used by getHash()
LOGIKS_HASH_SALT=

# Key used to sign and encrypt JWT tokens (rotating it invalidates issued tokens)
LOGIKS_JWT_SECRET=
