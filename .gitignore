# Logiks Framework - Git Ignore

# Temporary files
tmp/cache/*
tmp/logs/*
tmp/sessions/*
!tmp/cache/.gitkeep
!tmp/logs/.gitkeep
!tmp/sessions/.gitkeep

# Test results
test-results/*
!test-results/.gitkeep

# User data
data/uploads/*
!data/.gitkeep

# Dependencies
vendor/
node_modules/
plugins/vendors/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Docker volumes (data persists separately)
# But keep the Docker config files
!docker-compose.yml
!docker/

# Environment files
.env
.env.local
*.local.php

# Logs
*.log

# Database dumps
*.sql.gz
*.sql.zip
backup-*.sql

# Compiled/Generated files
*.cache
*.compiled

# OS files
Thumbs.db
Desktop.ini

# Lock files
composer.lock
package-lock.json
yarn.lock
todos.md
